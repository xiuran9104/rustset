{
  "name": "rustset-web",
  "version": "5.7.0",
  "description": "RustSet 资产、CMDB、云资源与运维管理平台前端工程",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "vben",
    "rustset",
    "asset management",
    "cmdb",
    "operations",
    "vue",
    "vue admin",
    "vue3"
  ],
  "license": "MIT",
  "author": {
    "name": "RustSet"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "bun install",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:antd": "turbo build --filter=@vben/web-antd",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:docs": "turbo build --filter=@vben/docs",
    "changeset": "changeset",
    "check": "bun run check:circular && bun run check:dep && bun run check:type && bun run check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:antd": "turbo dev --filter=@vben/web-antd",
    "dev:docs": "turbo dev --filter=@vben/docs",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "turbo run stub",
    "prepare": "is-ci || lefthook install",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "bun run clean -- --del-lock && bun install",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "changeset version && bun install",
    "catalog": "bunx codemod pnpm/catalog"
  },
