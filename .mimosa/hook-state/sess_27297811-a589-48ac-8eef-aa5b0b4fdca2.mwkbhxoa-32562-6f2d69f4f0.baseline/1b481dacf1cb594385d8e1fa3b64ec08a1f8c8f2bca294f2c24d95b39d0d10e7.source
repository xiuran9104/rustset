var e=[];for(let t=0;t<=15;t++)e[t]=t.toString(16);function t(){let t=``;for(let n=1;n<=36;n++)switch(n){case 9:case 14:case 19:case 24:t+=`-`;break;case 15:t+=4;break;case 20:t+=e[Math.random()*4|8];break;default:t+=e[Math.trunc(Math.random()*16)]}return t.replaceAll(`-`,``)}var n=0;function r(e=``){let t=Date.now(),r=Math.floor(Math.random()*1e9);return n++,`${e}_${r}${n}${String(t)}`}export{t as n,r as t};